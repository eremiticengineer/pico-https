#!/bin/bash

DEVICE="$1"

case "$DEVICE" in
    pico_w|pico2_w)
        ;;
    "")
        echo "No device specified."
        echo "Supported devices:"
        echo "  pico_w"
        echo "  pico2_w"
        exit 1
        ;;
    *)
        echo "Unknown device: $DEVICE"
        echo "Supported devices:"
        echo "  pico_w"
        echo "  pico2_w"
        exit 1
        ;;
esac

BUILD_DIR="build-${DEVICE}"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

cmake -DDEVICE="$DEVICE" ..
make -j4